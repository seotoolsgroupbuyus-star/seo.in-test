---
import Page from '../layouts/Page.astro';
import OriginalApp from '../components/OriginalApp';
import {products,productPath} from '../../src/data/products';
import {staticPages} from '../../src/data/staticPages';
import {getCompetitorMeta} from '../../src/data/competitorMeta';
import {withBrandTitle} from '../../src/seo/site';
export function getStaticPaths(){
 const defaults={
  'all-tools':[getCompetitorMeta('all-tools')?.title??'All Tools | SEO Group Buy',getCompetitorMeta('all-tools')?.description??'Browse all group buy SEO, AI, writing, and design tools available on SEO Group Buy.'],
  'blog':[getCompetitorMeta('blog')?.title??'Blog | SEO Group Buy',getCompetitorMeta('blog')?.description??'Guides and articles about group buy SEO and AI tools from SEO Group Buy.'],
  'pricing':['Pricing Plans','Compare SEO Group Buy plans — Lite $10/mo, Growth Starter $15/mo, Ahrefs Power Bundle $25/mo, Writer Toolkit, and more. Affordable group buy SEO tool access.'],
  'faq':['FAQ','Frequently asked questions about SEO Group Buy — how group buy access works, data privacy, refunds, uptime, and using tools for client projects.']
 };

 const routes=[...Object.entries(defaults).map(([path,[title,description]])=>({path,title:withBrandTitle(title),description})),
  ...products.map(p=>({path:productPath(p.slug).slice(1),title:withBrandTitle(p.title),description:p.description,product:p})),
  ...staticPages.map(p=>({path:p.slug,title:withBrandTitle(p.title),description:p.description}))];
 return routes.map(({path,title,description,product})=>({params:{slug:path},props:{title,description,path,product}}));
}
const {path,title,description,product}=Astro.props;
const pathname='/'+path.replace(/^\/+|\/+$/g,'');
const robots=import.meta.env.PUBLIC_PRODUCTION_INDEXABLE==='true'?'index,follow':'noindex,nofollow';
---
<Page title={title} description={description} pathname={pathname} robots={robots} product={product}>
 <OriginalApp path={pathname} client:load />
</Page>
